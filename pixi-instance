#!/usr/bin/env bash
# pixi-instance — pixi extension: multiple materialized instances of one environment.
#
# Each instance is a private copy of a workspace's pixi.toml + pixi.lock,
# installed into its own directory. Packages are hard-linked from the shared
# pixi cache, so instances are cheap. The lockfile is copied verbatim, so every
# instance resolves to the identical environment.
#
# Usage:
#   pixi instance create <name> (-w <registered-workspace> | -m <manifest-path>)
#   pixi instance run    <name> [pixi run args...] -- <command...>
#   pixi instance shell  <name> [pixi shell args...]
#   pixi instance list
#   pixi instance remove <name>

set -euo pipefail

INSTANCES_DIR="${PIXI_HOME:-$HOME/.pixi}/instances"

usage() { sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

die() { echo "pixi-instance: $*" >&2; exit 1; }

resolve_workspace() {
  # $1 = registered workspace name -> echoes its directory
  pixi workspace register list --json |
    python3 -c "import json,sys; print(json.load(sys.stdin)[sys.argv[1]])" "$1" 2>/dev/null ||
    die "workspace '$1' not found in registry (see: pixi workspace register list)"
}

instance_dir() { echo "$INSTANCES_DIR/$1"; }

cmd_create() {
  local name="" src="" manifest=""
  name="${1:?usage: pixi instance create <name> (-w <workspace> | -m <manifest-path>)}"; shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w|--workspace) src="$(resolve_workspace "$2")"; shift 2 ;;
      -m|--manifest-path) src="$(cd "$(dirname "$2")" && pwd)"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ -n "$src" ]] || die "need -w <workspace> or -m <manifest-path>"

  for f in pixi.toml pyproject.toml; do
    [[ -f "$src/$f" ]] && manifest="$f" && break
  done
  [[ -n "$manifest" ]] || die "no pixi.toml/pyproject.toml in $src"

  local dir; dir="$(instance_dir "$name")"
  [[ -e "$dir" ]] && die "instance '$name' already exists ($dir)"
  mkdir -p "$dir"
  cp "$src/$manifest" "$dir/"
  [[ -f "$src/pixi.lock" ]] && cp "$src/pixi.lock" "$dir/"
  echo "$src" > "$dir/.source"

  # --frozen: install exactly the copied lockfile, never re-solve
  pixi install --manifest-path "$dir/$manifest" --frozen
  echo "instance '$name' ready: pixi instance run $name -- <cmd>"
}

manifest_of() {
  local dir; dir="$(instance_dir "$1")"
  [[ -d "$dir" ]] || die "no instance '$1' (see: pixi instance list)"
  for f in pixi.toml pyproject.toml; do
    [[ -f "$dir/$f" ]] && { echo "$dir/$f"; return; }
  done
  die "instance '$1' has no manifest"
}

cmd_run()   { local m; m="$(manifest_of "${1:?name required}")"; shift; exec pixi run   --manifest-path "$m" "$@"; }
cmd_shell() { local m; m="$(manifest_of "${1:?name required}")"; shift; exec pixi shell --manifest-path "$m" "$@"; }

cmd_list() {
  [[ -d "$INSTANCES_DIR" ]] || exit 0
  local d
  for d in "$INSTANCES_DIR"/*/; do
    [[ -d "$d" ]] || continue
    printf "%s\t(from %s)\n" "$(basename "$d")" "$(cat "$d/.source" 2>/dev/null || echo '?')"
  done
}

cmd_remove() {
  local dir; dir="$(instance_dir "${1:?name required}")"
  [[ -d "$dir" ]] || die "no instance '$1'"
  rm -rf "$dir"
  echo "removed instance '$1'"
}

case "${1:-}" in
  create) shift; cmd_create "$@" ;;
  run)    shift; cmd_run "$@" ;;
  shell)  shift; cmd_shell "$@" ;;
  list|ls) cmd_list ;;
  remove|rm) shift; cmd_remove "$@" ;;
  *) usage ;;
esac
